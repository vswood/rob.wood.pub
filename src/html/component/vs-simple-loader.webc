<template id="vs-simple-loader-template" shadowrootmode="open">

  <style webc:keep>

    @keyframes delay {

      0%,
      40%,
      100% {
        transform: scaleY(0.05);
        -webkit-transform: scaleY(0.05);
      }

      20% {
        transform: scaleY(1);
        -webkit-transform: scaleY(1);
      }
    }

    :host {
      visibility: hidden;
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 500;
    }

    :host(.loading) {
      visibility: visible;
    }

    :host(.loading) {
      .loader {
        margin: 0 auto;
        width: 60px;
        height: 50px;
        text-align: center;
        font-size: 10px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translateY(-50%) translateX(-50%);
        z-index: 500;
        opacity: 1;

        div {
          height: 100%;
          width: 8px;
          display: inline-block;
          float: left;
          margin-left: 2px;
          -webkit-animation: delay 0.8s infinite ease-in-out;
          animation: delay 0.8s infinite ease-in-out;

          &.bar1 {
            background-color: #754fa0;
          }

          &.bar2 {
            background-color: #09b7bf;
            -webkit-animation-delay: -0.7s;
            animation-delay: -0.7s;
          }

          &.bar3 {
            background-color: #90d36b;
            -webkit-animation-delay: -0.6s;
            animation-delay: -0.6s;
          }

          &.bar4 {
            background-color: #f2d40d;
            -webkit-animation-delay: -0.5s;
            animation-delay: -0.5s;
          }

          &.bar5 {
            background-color: #fcb12b;
            -webkit-animation-delay: -0.4s;
            animation-delay: -0.4s;
          }

          &.bar6 {
            background-color: #ed1b72;
            -webkit-animation-delay: -0.3s;
            animation-delay: -0.3s;
          }
        }
      }
    }
  </style>

  <div id="preloader">
    <div class="loader">
      <div class="bar1"></div>
      <div class="bar2"></div>
      <div class="bar3"></div>
      <div class="bar4"></div>
      <div class="bar5"></div>
      <div class="bar6"></div>
    </div>
  </div>

  <script type="module" webc:keep>
    import vsApp from '/js/lib/VirtualStyleApp.js'
    class VsSimpleLoader extends HTMLElement {
      #loaded = false
      #started

      constructor () {
        super()
      }

      delayInit() {
        setTimeout(() => {
          if (this.#loaded !== true) {
            this.init()
          } /*else {
            this.delayedExit()
          }*/
        }, 330)
      }

      handleEvent(e) {
        this[`${e.type.replace(':', '')}Handler`](e)
      }

      windowloadedHandler() {
        this.delayedExit()
      }

      init() {
        this.classList.add('loading')
        this.#started = performance.now()
      }

      delayedExit() {
        const elapsed = performance.now() - this.#started
        if(elapsed >= 1000) {
          this.exit()
        } else {
          setTimeout(() => {
            this.exit()
          }, 1000 - elapsed)
        }
      }

      exit() {
        this.#loaded = true
        this.classList.remove('loading')
        this.style.display = 'none'
        const headerToggle = document.querySelector('.nav-wrapper .header-toggle')
        if (headerToggle) {
          headerToggle.style.opacity = 1
        }
        vsApp.emit('preloader:exit')
      }

      set loaded(value) {
        this.#loaded = value
      }

      get loaded() {
        return this.#loaded
      }

      connectedCallback () {
        window.addEventListener('window:loaded', this)
        this.delayInit()
      }

      disconnectedCallback() {
        window.removeEventListener('window:loaded', this)
      }
    }

    customElements.define('vs-simple-loader', VsSimpleLoader)
  </script>

</template>
