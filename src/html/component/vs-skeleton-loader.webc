<template id="vs-skeleton-loader-template" shadowrootmode="open">

  <style webc:keep>

    :host {
      visibility: hidden;
      width: 100%;
      height: 100%;
    }

    :host(.loading) {
      visibility: visible;
    }

    :root {
      --sk-bg-color: rgba(226, 232, 240, 0.7);
      --sk-shimmer-color: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.3) 35%,
        rgba(255, 255, 255, 0.5) 50%,
        rgba(255, 255, 255, 0.3) 65%,
        rgba(255, 255, 255, 0) 100%
      );
      --sk-animation-duration: 1.8s;
      --sk-border-radius-default: 6px;
    }

    .sk-container.sk-light {
      --sk-bg-color: rgba(226, 232, 240, 0.85);
      --sk-shimmer-color: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.3) 35%,
        rgba(255, 255, 255, 0.5) 50%,
        rgba(255, 255, 255, 0.3) 65%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    .sk-container.sk-dark {
      --sk-bg-color: rgba(45, 55, 72, 0.85);
      --sk-shimmer-color: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.04) 35%,
        rgba(255, 255, 255, 0.08) 50%,
        rgba(255, 255, 255, 0.04) 65%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --sk-bg-color: rgba(45, 55, 72, 0.7);
        --sk-shimmer-color: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.04) 35%,
          rgba(255, 255, 255, 0.08) 50%,
          rgba(255, 255, 255, 0.04) 65%,
          rgba(255, 255, 255, 0) 100%
        );
      }
    }

    .sk-container {
      pointer-events: none;
      user-select: none;
    }

    .sk-block {
      display: inline-block;
      background-color: var(--sk-bg-color);
      border-radius: var(--sk-border-radius-default);
      position: relative;
      overflow: hidden;
      vertical-align: middle;
    }

    .sk-shimmer {
      overflow: clip;
    }

    .sk-container.sk-shimmer {
      .sk-shimmer::before {
        content: "";
        z-index: 10;
        position: absolute;
        height: 200%;
        width: 200%;
        top: -120%;
        left: -120%;
        background: linear-gradient(transparent 0%,
            rgba(255, 255, 255, 0.1) 45%,
            rgba(255, 255, 255, 0.35) 50%,
            rgba(255, 255, 255, 0.1) 55%,
            transparent 100%);
        transition: all 2s;
        transform: rotate(-60deg);
        animation: sk-shimmer-shine var(--sk-animation-duration) infinite ease-in-out forwards;
      }
      /* .sk-shimmer::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        transform: translateX(-100%);
        background: var(--sk-shimmer-color);
        animation: sk-shimmer-slide calc(var(--sk-animation-duration) + 0.25s) infinite ease-in-out;
        will-change: transform;
      } */
    }

    @keyframes sk-shimmer-shine {
      0% {
          top: -120%;
          left: -120%;
      }
      100% {
          left:100%;
          top:100%;
      }
    }

    @keyframes sk-shimmer-slide {
      0% {
        transform: translateX(-100%);
      }
      100% {
        transform: translateX(100%);
      }
    }

    .sk-text {
      display: block;
      height: 1em;
      background-color: var(--sk-bg-color);
      border-radius: 4px;
      margin-bottom: 0.5em;
      position: relative;
      overflow: hidden;
    }

    .sk-text.sk-heading {
      height: 1.5em;
      margin-bottom: 0.8em;
    }

    .sk-circle {
      border-radius: 50% !important;
    }

    .sk-rect {
      display: block;
      background-color: var(--sk-bg-color);
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    .sk-row {
      display: flex;
      flex-direction: row;
    }

    .sk-col {
      display: flex;
      flex-direction: column;
    }


  </style>

  <div id="preloader">
    <div class="sk-container sk-shimmer sk-dark" style="position: relative; width: 100%; aspect-ratio: 0.883; min-height: 1699px;">
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 3.6%; top: 1.8%; width: 24.5%; height: 3.6%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 3.7%; top: 12.1%; width: 7.6%; height: 1.5%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 4.1%; top: 14.0%; width: 34.5%; height: 4.6%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 4.0%; top: 19.5%; width: 1.9%; height: 1.3%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 6.3%; top: 19.5%; width: 25.9%; height: 4.9%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 33.1%; top: 19.4%; width: 7.8%; height: 1.5%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 3.7%; top: 28.6%; width: 21.3%; height: 2.6%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 27.3%; top: 28.7%; width: 21.3%; height: 2.6%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 2.6%; top: 36.1%; width: 28.5%; height: 2.0%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 2.7%; top: 38.5%; width: 19.3%; height: 1.1%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 2.7%; top: 42.3%; width: 42.7%; height: 2.5%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 2.5%; top: 46.9%; width: 45.0%; height: 2.9%; border-radius: 6px;"></div>
      <div class="sk-rect sk-shimmer" style="position: absolute; left: 55.2%; top: 12.3%; width: 37.3%; height: 32.8%; border-radius: 6px;"></div>
    </div>
  </div>

  <script type="module" webc:keep>
    import vsApp from '/js/VirtualStyleApp.js'
    class VsSkeletonLoader extends HTMLElement {
      #loaded = false
      #started

      constructor () {
        super()
      }

      delayInit() {
        setTimeout(() => {
          if (this.#loaded !== true) {
            this.init()
          } /*else {
            this.delayedExit()
          }*/
        }, 330)
      }

      handleEvent(e) {
        this[`${e.type.replace(':', '')}Handler`](e)
      }

      windowloadedHandler() {
        this.delayedExit()
      }

      init() {
        this.classList.add('loading')
        this.#started = performance.now()
      }

      delayedExit() {
        const elapsed = performance.now() - this.#started
        if(elapsed >= 1000) {
          this.exit()
        } else {
          setTimeout(() => {
            this.exit()
          }, 1000 - elapsed)
        }
      }

      exit() {
        this.#loaded = true
        this.classList.remove('loading')
        this.style.display = 'none'
        vsApp.emit('preloader:exit')
      }

      set loaded(value) {
        this.#loaded = value
      }

      get loaded() {
        return this.#loaded
      }

      connectedCallback () {
        window.addEventListener('window:loaded', this)
        this.delayInit()
      }

      disconnectedCallback() {
        window.removeEventListener('window:loaded', this)
      }
    }

    customElements.define('vs-skeleton-loader', VsSkeletonLoader)
  </script>

</template>
