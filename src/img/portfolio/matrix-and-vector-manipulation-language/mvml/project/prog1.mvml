mvml

matrix A= matrix(2;2);
matrix B= matrix(2;2);
matrix C= matrix(2;2);
vector d= vector(4);
vector e= vector(4);
vector f= vector(4);

out("Fill Matrix A:");
fill(A);
out("Fill Matrix B:");
fill(B);
out("Matrix A=");
print(A);
out("Matrix B=");
print(B);
C=A+B;
out("Matrix C=A+B");
print(C);
C=A-B;
out("Matrix C=A-B");
print(C);
out("Fill Vector d:");
fill(d);
out("Fill Vector e:");
fill(e);
out("Vector d=");
print(d);
out("Vector e=");
print(e);
f=d+e;
out("Vector f=d+e");
print(f);
f=d-e;
out("Vector f=d-e");
print(f);

/mvml
