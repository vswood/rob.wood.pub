{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rwp-contact-form",
  "main": "./src/api/index.js",
  "send_metrics": false,
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [ "nodejs_compat" ],
  "workers_dev": false,
  "route": {
    "pattern": "rob.wood.pub/*",
    "zone_name": "wood.pub"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "secrets_store_secrets": [
    {
      "binding": "MAILGUN_API_KEY",
      "store_id": "4ebb59c094e4442e9c50ab90102470e4",
      "secret_name": "MAILGUN_API_KEY"
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "4ebb59c094e4442e9c50ab90102470e4",
      "secret_name": "TURNSTILE_SECRET"
    }
  ],
  "vars": {
    "MAILGUN_DOMAIN": "mg.virtualstyle.us",
    "FORMMAIL_FROM": "Portfolio Webform <postmaster@mg.virtualstyle.us>",
    "FORMMAIL_TO": "Rob Wood <rob@virtualstyle.us>"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
