    "clean-css": "^5.3.3",
    "cssnano": "^8.0.1",
    "documentation": "^14.0.3",
    "eleventy-plugin-gen-favicons": "^1.1.3",
    "eleventy-plugin-icons": "^4.5.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-glob": "^3.3.3",
    "fontless": "^0.2.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "hast-util-is-element": "^3.0.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-dom": "^4.0.1",
    "hast-util-to-html": "^9.0.5",
    "html-minifier-terser": "^7.2.0",
    "jsdoc": "^4.0.5",
    "monocart-coverage-reports": "^2.12.11",
    "postcss": "^8.5.15",
    "postcss-class-apply": "^4.0.1",
    "postcss-discard-comments": "^8.0.0",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-url": "^10.1.4",
    "rollup-plugin-critical": "^1.0.15",
    "svg-parser": "^2.0.4",
    "terser": "^5.48.0",
