    "@mocks-server/config": "^1.4.1",
    "@popperjs/core": "^2.11.8",
    "@srexi/purecounterjs": "^1.5.0",
    "bootstrap": "^5.3.8",
    "glightbox": "^3.3.1",
    "gsap": "^3.15.0",
    "jquery": "^4.0.0",
    "lenis": "^1.3.23",
    "lottie-web": "^5.13.0",
