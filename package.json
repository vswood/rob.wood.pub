{
  "name": "@virtualstyle/rob.wood.pub",
  "description": "Rob Wood's professional portfolio website by virtualStyle intelligent systems engineering (virtualstyle.us).",
  "version": "0.2.0",
  "type": "module",
  "author": "Rob Wood <rob@virtualstyle.us> (https://virtualstyle.us/)",
  "license": "UNLICENSED",
  "vsMeta": {
    "copyright": "Copyright © 2026 Rob Wood (https://virtualstyle.us)"
  },
  "browserslist": [
    "defaults",
    "cover 99% in US",
    "last 2 versions"
  ],
  "scripts": {
    "build": "ELEVENTY_ENV=prod eleventy",
    "build-dev": "ELEVENTY_ENV=dev eleventy",
    "dev": "ELEVENTY_ENV=dev eleventy --serve",
    "devb": "DEBUG=Eleventy:Benchmark* ELEVENTY_ENV=dev eleventy --serve",
    "devdb": "DEBUG=Eleventy:* ELEVENTY_ENV=dev eleventy --serve",
    "devc": "ELEVENTY_ENV=dev npx --node-options=\"--cpu-prof\" eleventy --serve --quiet",
    "stage": "ELEVENTY_ENV=prod eleventy --serve",
    "docshtml": "documentation build src/** --config documentation.yml -f html -o docs/rob.wood.pub/html/",
    "docsmd": "documentation build src/** --config documentation.yml -f md -o docs/rob.wood.pub/markdown.md",
    "wc-test": "web-test-runner test/**/*.test.js --node-resolve",
    "test": "vitest --run",
    "lint": "eslint -c ./eslint.config.js ./*.js ./src/**/*.js --fix --no-warn-ignored --no-error-on-unmatched-pattern .",
    "jsdocs": "jsdoc --verbose --debug -c ./jsdoc.config.js -P package.json -R ./README.md",
    "cve": "pnx cve-lite-cli ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-directory-output": "^1.0.2",
    "@11ty/eleventy-plugin-ejs": "^1.0.0",
    "@11ty/eleventy-plugin-vite": "8.0.0-alpha.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@alphanull/jsdoc-plugin-esnext": "^1.3.0",
    "@alphanull/jsdoc-vision-theme": "^1.2.2",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.2.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@quasibit/eleventy-plugin-schema": "^1.13.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "4.1.7",
    "@web/test-runner": "^0.20.2",
